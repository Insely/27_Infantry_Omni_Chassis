{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build task",
      "type": "process",
      "command": "/usr/bin/make",
      "args": [
        "-j12",
        "GCC_PATH=/opt/homebrew/bin"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
